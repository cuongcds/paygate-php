{
    "name": "cuongcds/paygate-php",
    "description": "PHP SDK for the PayGate payment gateway API",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-curl": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "autoload": {
        "psr-4": {
            "PayGate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PayGate\\Tests\\": "tests/"
        }
    }
}
